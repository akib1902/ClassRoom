# ---------------------------------------------------------------------------
# Classroom API — copy to `server/.env` and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Leave empty to bind every interface (normal behind a managed proxy), or pin it to
# a loopback address such as 127.0.0.1 / ::1 during local development.
HOST=
# Set to true only when a reverse proxy you control terminates TLS and sets
# X-Forwarded-For; otherwise client IPs (and the rate limiter) can be spoofed.
TRUST_PROXY=false
DATABASE_PATH=./classroom.db

# --- Origins ---------------------------------------------------------------
# Where the SPA is served from. Google sends the user back here after sign-in.
APP_ORIGIN=http://localhost:5173
# Origins allowed to call this API with the session cookie. Comma-separated.
ALLOWED_ORIGINS=http://localhost:5173
# Public origin of THIS API. It builds the Google redirect URI, which must match
# the URI registered in the Google Cloud Console *exactly*:
#   <API_ORIGIN>/api/auth/google/callback
API_ORIGIN=http://localhost:4000

# --- Secrets ---------------------------------------------------------------
# 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this invalidates every active session (and pending OAuth attempt).
# Development note: leaving this empty generates a random secret per boot (with a
# warning) so you can try the flow immediately; production refuses to start.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
JWT_ISSUER=classroom-api
JWT_AUDIENCE=classroom-app

# --- Google OAuth ----------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). See README §10 for the full walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: restrict sign-in to these Google Workspace domains (comma-separated).
# The value is matched against the ID token's `hd` claim.
GOOGLE_ALLOWED_DOMAINS=

# Optional: these addresses get the `admin` role on first sign-in. Everyone else
# starts as `student`; the sign-up form cannot choose a role.
ADMIN_EMAILS=

# Leave the defaults unless you point the flow at a mock Google.
# GOOGLE_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
# GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# --- Cookies ---------------------------------------------------------------
# lax  — SPA and API share a registrable domain (localhost:5173 + localhost:4000,
#        or app.example.com + api.example.com). Correct default.
# none — SPA and API live on different domains. Requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Set to true to disable the auth rate limits (tests only).
RATE_LIMIT_DISABLED=false
