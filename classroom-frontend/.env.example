# --- Frontend (Vite) -------------------------------------------------------
# Base URL for the REST data provider. Point this at the real API once it
# serves resources; until then the in-memory/IndexedDB provider is used.
VITE_API_URL=https://api.fake-rest.refine.dev

# Authentication source:
#   mock (default) — offline demo provider: any credentials sign in, no backend
#   api            — real sign-in through `server/` (Google OAuth + JWT sessions)
VITE_AUTH_MODE=mock

# Base URL of the auth API. Only read when VITE_AUTH_MODE=api.
VITE_AUTH_API_URL=http://localhost:4000/api
